<?xml version="1.0" encoding="utf-8"?>
<!--
    Opt out of automatic backup of any user data.
    Tidelet stores sensitive personal information (cravings, check-ins) locally and never
    leaves the device in v1.
-->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
