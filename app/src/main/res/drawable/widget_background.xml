<?xml version="1.0" encoding="utf-8"?>
<!--
    Rounded warm-ivory background for the streak widget. Matches the app's
    surface-raised treatment: a subtle 1dp border on a neutral fill, no
    drop shadow. Corner radius 16dp matches Shapes.md in the Compose design
    system.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_background" />
    <stroke android:width="1dp" android:color="@color/widget_border" />
    <corners android:radius="16dp" />
</shape>
