<?xml version="1.0" encoding="utf-8"?>
<!--
    Traces the sage ring clockwise by animating the path's trimPathEnd from
    0 → 1 over 400 ms. Uses the Android `fast_out_slow_in` interpolator which
    matches the design system's Standard_Easing (cubic(0.4, 0, 0.2, 1)).
-->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:propertyName="trimPathEnd"
    android:valueFrom="0"
    android:valueTo="1"
    android:valueType="floatType"
    android:duration="400"
    android:interpolator="@android:interpolator/fast_out_slow_in" />
