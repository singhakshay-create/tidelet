    <string name="health_recovery_24h_title">24 hours</string>
    <string name="health_recovery_24h_body">Blood alcohol clears; for most people, sleep starts to look more normal tonight.</string>

    <string name="health_recovery_72h_title">72 hours</string>
    <string name="health_recovery_72h_body">Acute withdrawal typically fades. Many people report thinking feels a little sharper.</string>

    <string name="health_recovery_2w_title">Two weeks</string>
    <string name="health_recovery_2w_body">Liver fat commonly starts reducing. Cravings often feel less constant around this point.</string>

    <string name="health_recovery_30d_title">30 days</string>
    <string name="health_recovery_30d_body">Liver enzymes typically begin trending down. Skin and hydration often start to look better too.</string>

    <string name="health_recovery_90d_title">90 days</string>
    <string name="health_recovery_90d_body">Imaging studies commonly show early prefrontal-cortex recovery at this stage — the part of the brain that handles impulse control.</string>

    <string name="health_recovery_1yr_title">One year</string>
    <string name="health_recovery_1yr_body">Most of the measurable health gains from abstinence are typically in place by now. Many people describe it as a steady identity shift rather than a milestone.</string>

