    <!-- Cognitive distortions library -->
    <string name="distortions_title">Common thought patterns</string>
    <string name="distortions_intro">These are shapes drinking-thoughts often take. Spotting one is already half the work.</string>
    <string name="distortions_back">Back</string>

    <string name="distortion_all_or_nothing">All-or-nothing</string>
    <string name="distortion_all_or_nothing_def">Seeing things in black-and-white — you\'re either perfect or it\'s ruined.</string>
    <string name="distortion_all_or_nothing_ex">\"I had one drink, so the whole month is wasted — may as well keep going.\"</string>

    <string name="distortion_permission_giving">Permission-giving</string>
    <string name="distortion_permission_giving_def">Finding a reason why this time is the exception.</string>
    <string name="distortion_permission_giving_ex">\"It\'s been a long week. I\'ve earned this one.\"</string>

    <string name="distortion_emotional_reasoning">Emotional reasoning</string>
    <string name="distortion_emotional_reasoning_def">Treating a feeling as the verdict on what\'s true.</string>
    <string name="distortion_emotional_reasoning_ex">\"I feel like I can\'t cope without it, so I can\'t.\"</string>

    <string name="distortion_fortune_telling">Fortune-telling</string>
    <string name="distortion_fortune_telling_def">Predicting the future with certainty — usually the worst version.</string>
    <string name="distortion_fortune_telling_ex">\"This craving won\'t stop unless I drink.\"</string>

    <string name="distortion_minimizing">Minimizing</string>
    <string name="distortion_minimizing_def">Shrinking the importance of the progress you\'ve made.</string>
    <string name="distortion_minimizing_ex">\"Eleven days was nothing. It barely counts.\"</string>

    <string name="distortion_magnifying">Magnifying</string>
    <string name="distortion_magnifying_def">Blowing up the hardness of the moment out of proportion.</string>
    <string name="distortion_magnifying_ex">\"This is unbearable. I literally can\'t get through tonight.\"</string>

    <string name="distortion_should_ing">Should-ing</string>
    <string name="distortion_should_ing_def">Wielding \"should\" against yourself — usually to harsh effect.</string>
    <string name="distortion_should_ing_ex">\"I should be over this by now. What\'s wrong with me.\"</string>

    <string name="distortion_mental_filter">Mental filter</string>
    <string name="distortion_mental_filter_def">Noticing only the evidence that fits the craving.</string>
    <string name="distortion_mental_filter_ex">\"Tonight\'s been rough — forget the ten good nights before it.\"</string>

    <string name="distortion_personalization">Personalization</string>
    <string name="distortion_personalization_def">Reading a neutral situation as being about you, and needing to fix it with a drink.</string>
    <string name="distortion_personalization_ex">\"They\'re quiet because of me. I need something to smooth this.\"</string>

    <string name="distortion_labeling">Labeling</string>
    <string name="distortion_labeling_def">Turning a behaviour into a fixed identity.</string>
    <string name="distortion_labeling_ex">\"I\'m an alcoholic and that\'s just who I am. What\'s the point.\"</string>

    <!-- Distortion antidotes — one short technique + one challenging question each. -->
    <string name="distortion_all_or_nothing_technique">Find the middle ground.</string>
    <string name="distortion_all_or_nothing_question">Would I judge a friend this harshly for the same slip?</string>

    <string name="distortion_permission_giving_technique">Name the thought out loud. It loses power when said.</string>
    <string name="distortion_permission_giving_question">What does \"just this once\" actually cost me this time?</string>

    <string name="distortion_emotional_reasoning_technique">Feelings aren\'t evidence. Treat the feeling as weather, not fact.</string>
    <string name="distortion_emotional_reasoning_question">If I weren\'t feeling this, would I still believe it?</string>

    <string name="distortion_fortune_telling_technique">Name it: \"I\'m predicting, not knowing.\"</string>
    <string name="distortion_fortune_telling_question">What\'s one time this prediction was wrong?</string>

    <string name="distortion_minimizing_technique">Put the actual number on it.</string>
    <string name="distortion_minimizing_question">If a friend did this, would I call it small?</string>

    <string name="distortion_magnifying_technique">Say it smaller. One slip, not a collapse.</string>
    <string name="distortion_magnifying_question">On a scale of 1 to 10, how bad is this actually?</string>

    <string name="distortion_should_ing_technique">Swap \"should\" for \"would prefer to.\"</string>
    <string name="distortion_should_ing_question">Who decided this was a rule?</string>

    <string name="distortion_mental_filter_technique">Add one good thing you\'re ignoring.</string>
    <string name="distortion_mental_filter_question">What am I not counting right now?</string>

    <string name="distortion_personalization_technique">Separate your part from what wasn\'t yours.</string>
    <string name="distortion_personalization_question">What did I actually control here?</string>

    <string name="distortion_labeling_technique">Describe the behaviour, not the person.</string>
    <string name="distortion_labeling_question">What would I say about a friend who did this once?</string>

    <!-- "Not a thought?" callout at the bottom of the Distortions library. -->
    <string name="distortion_habit_callout_title">Not a thought — more of a habit?</string>
    <string name="distortion_habit_callout_body">Sometimes drinking isn\'t led by a thought at all. It\'s the 6 pm reach, the weekend routine, the same chair. That\'s a habit loop, not a distortion. Log it as a trigger on your daily check-in to track it over time.</string>
